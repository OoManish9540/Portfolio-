<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Manish Kumar — Portfolio</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>

  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/TextPlugin.min.js"></script>

  <!-- Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <style>
    :root {
      --bg: #020408;
      --bg2: #060d18;
      --cyan: #00f5ff;
      --blue: #0066ff;
      --neon: #00ff9d;
      --purple: #7b2fff;
      --text: #e8f4ff;
      --muted: #4a6a8a;
      --card: rgba(0,30,60,0.5);
      --border: rgba(0,245,255,0.15);
    }

    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Rajdhani', sans-serif;
      overflow-x: hidden;
      cursor: none;
    }

    /* ─── CUSTOM CURSOR ─── */
    #cursor {
      position: fixed;
      width: 12px; height: 12px;
      background: var(--cyan);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%,-50%);
      transition: width .2s, height .2s, background .2s;
      box-shadow: 0 0 10px var(--cyan), 0 0 20px var(--cyan);
    }
    #cursor-ring {
      position: fixed;
      width: 40px; height: 40px;
      border: 1px solid rgba(0,245,255,.5);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%,-50%);
      transition: all .15s ease-out;
    }

    /* ─── THREE.JS CANVAS ─── */
    #three-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* ─── NAV ─── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1.2rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      background: rgba(2,4,8,.6);
    }
    .nav-logo {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--cyan);
      letter-spacing: 3px;
      text-shadow: 0 0 15px var(--cyan);
    }
    .nav-links { display: flex; gap: 2.5rem; list-style: none; }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: .95rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: color .3s;
      position: relative;
    }
    .nav-links a::after {
      content:'';
      position: absolute;
      bottom: -4px; left: 0;
      width: 0; height: 1px;
      background: var(--cyan);
      transition: width .3s;
    }
    .nav-links a:hover { color: var(--cyan); }
    .nav-links a:hover::after { width: 100%; }

    /* ─── SECTIONS ─── */
    section {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      padding: 7rem 6rem 5rem;
    }

    /* ─── HERO ─── */
    #hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4rem;
      overflow: hidden;
    }

    .hero-left { flex: 1; }

    .hero-eyebrow {
      font-family: 'Space Mono', monospace;
      font-size: .75rem;
      color: var(--neon);
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      opacity: 0;
    }

    .hero-name {
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 900;
      line-height: 1;
      color: #fff;
      opacity: 0;
    }
    .hero-name span {
      display: block;
      background: linear-gradient(135deg, var(--cyan), var(--blue), var(--purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-title {
      margin-top: 1.5rem;
      font-size: 1.4rem;
      color: var(--muted);
      letter-spacing: 3px;
      font-weight: 300;
      text-transform: uppercase;
      opacity: 0;
    }
    .hero-title b { color: var(--cyan); }

    .hero-desc {
      margin-top: 2rem;
      max-width: 480px;
      line-height: 1.8;
      font-size: 1.05rem;
      color: rgba(232,244,255,.6);
      opacity: 0;
    }

    .hero-cta {
      display: flex;
      gap: 1.2rem;
      margin-top: 3rem;
      opacity: 0;
    }

    .btn-primary {
      padding: .85rem 2.2rem;
      background: transparent;
      border: 1px solid var(--cyan);
      color: var(--cyan);
      font-family: 'Orbitron', sans-serif;
      font-size: .75rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: none;
      transition: all .3s;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--cyan);
      transform: translateX(-101%);
      transition: transform .3s;
      z-index: -1;
    }
    .btn-primary:hover { color: var(--bg); }
    .btn-primary:hover::before { transform: translateX(0); }

    .btn-secondary {
      padding: .85rem 2.2rem;
      background: transparent;
      border: 1px solid var(--muted);
      color: var(--muted);
      font-family: 'Orbitron', sans-serif;
      font-size: .75rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: none;
      transition: all .3s;
      text-decoration: none;
    }
    .btn-secondary:hover { border-color: var(--neon); color: var(--neon); }

    /* Hero image */
    .hero-right {
      flex: 0 0 420px;
      position: relative;
      opacity: 0;
    }
    .hero-img-wrap {
      position: relative;
      width: 380px;
      height: 480px;
    }
    .hero-img-wrap::before {
      content: '';
      position: absolute;
      inset: -2px;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--blue));
      z-index: -1;
      clip-path: polygon(0 0,100% 0,100% 85%,85% 100%,0 100%);
    }
    .hero-img-wrap::after {
      content: '';
      position: absolute;
      bottom: -20px; right: -20px;
      width: 100%; height: 100%;
      border: 1px solid rgba(0,245,255,.2);
      clip-path: polygon(0 0,100% 0,100% 85%,85% 100%,0 100%);
      z-index: -2;
    }
    .hero-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      clip-path: polygon(0 0,100% 0,100% 85%,85% 100%,0 100%);
      display: block;
      filter: saturate(1.1) contrast(1.05);
    }
    .scan-line {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      animation: scanDown 3s linear infinite;
      z-index: 2;
    }
    @keyframes scanDown {
      0% { top: 0; opacity: 1; }
      90% { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }

    /* Corner decorations */
    .corner {
      position: absolute;
      width: 20px; height: 20px;
    }
    .corner-tl { top: -5px; left: -5px; border-top: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
    .corner-tr { top: -5px; right: -5px; border-top: 2px solid var(--cyan); border-right: 2px solid var(--cyan); }
    .corner-bl { bottom: -5px; left: -5px; border-bottom: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
    .corner-br { bottom: -5px; right: -5px; border-bottom: 2px solid var(--cyan); border-right: 2px solid var(--cyan); }

    /* Stats row */
    .hero-stats {
      display: flex;
      gap: 3rem;
      margin-top: 3rem;
      opacity: 0;
    }
    .stat { text-align: left; }
    .stat-num {
      font-family: 'Orbitron', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--cyan);
    }
    .stat-label {
      font-size: .8rem;
      color: var(--muted);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* ─── SECTION HEADER ─── */
    .sec-header {
      margin-bottom: 4rem;
      position: relative;
    }
    .sec-tag {
      font-family: 'Space Mono', monospace;
      font-size: .7rem;
      color: var(--neon);
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: .8rem;
    }
    .sec-title {
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 700;
      color: #fff;
      line-height: 1;
    }
    .sec-title span { color: var(--cyan); }
    .sec-line {
      display: block;
      width: 60px;
      height: 2px;
      background: linear-gradient(90deg, var(--cyan), transparent);
      margin-top: 1.2rem;
    }

    /* ─── ABOUT ─── */
    #about { background: linear-gradient(to bottom, transparent, rgba(0,20,40,.4), transparent); }

    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
      align-items: center;
    }

    .about-text p {
      font-size: 1.1rem;
      line-height: 1.9;
      color: rgba(232,244,255,.7);
      margin-bottom: 1.5rem;
    }
    .about-text p strong { color: var(--cyan); }

    .about-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-top: 2rem;
    }
    .info-item {
      padding: 1rem 1.2rem;
      border: 1px solid var(--border);
      background: var(--card);
      backdrop-filter: blur(8px);
    }
    .info-label {
      font-size: .65rem;
      letter-spacing: 3px;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: .3rem;
    }
    .info-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
    }

    .education-timeline { position: relative; }
    .edu-item {
      padding: 1.5rem 1.5rem 1.5rem 3rem;
      border-left: 1px solid var(--border);
      margin-bottom: 1.5rem;
      position: relative;
      background: var(--card);
      backdrop-filter: blur(8px);
    }
    .edu-item::before {
      content: '';
      position: absolute;
      left: -5px; top: 1.8rem;
      width: 9px; height: 9px;
      background: var(--cyan);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--cyan);
    }
    .edu-degree {
      font-family: 'Orbitron', sans-serif;
      font-size: .85rem;
      font-weight: 700;
      color: var(--cyan);
      margin-bottom: .3rem;
    }
    .edu-school { font-size: 1rem; color: var(--text); font-weight: 600; }
    .edu-year { font-size: .75rem; color: var(--muted); letter-spacing: 2px; margin-top: .3rem; }

    /* ─── SKILLS ─── */
    #skills { }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .skill-card {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 2rem;
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
      transition: border-color .3s, transform .3s;
      clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
    }
    .skill-card::before {
      content:'';
      position: absolute;
      top: 0; right: 0;
      width: 0; height: 0;
      border-left: 20px solid transparent;
      border-top: 20px solid var(--cyan);
      opacity: .3;
    }
    .skill-card:hover { border-color: var(--cyan); transform: translateY(-4px); }

    .skill-icon {
      font-size: 2.2rem;
      margin-bottom: 1rem;
    }
    .skill-cat {
      font-family: 'Orbitron', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      color: var(--cyan);
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }
    .skill-tags { display: flex; flex-wrap: wrap; gap: .5rem; }
    .skill-tag {
      padding: .3rem .8rem;
      border: 1px solid rgba(0,245,255,.2);
      font-size: .8rem;
      font-family: 'Space Mono', monospace;
      color: rgba(232,244,255,.7);
      background: rgba(0,245,255,.04);
      transition: all .2s;
    }
    .skill-tag:hover { border-color: var(--cyan); color: var(--cyan); background: rgba(0,245,255,.1); }

    /* Skill bars */
    .skill-bar-wrap { margin-top: 1.5rem; }
    .skill-bar-label {
      display: flex;
      justify-content: space-between;
      font-size: .8rem;
      color: var(--muted);
      margin-bottom: .4rem;
      font-family: 'Space Mono', monospace;
    }
    .skill-bar-track {
      height: 3px;
      background: rgba(255,255,255,.06);
      position: relative;
      overflow: hidden;
    }
    .skill-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--cyan), var(--blue));
      width: 0;
      box-shadow: 0 0 8px var(--cyan);
      transition: width 1.5s cubic-bezier(.25,.46,.45,.94);
    }

    /* ─── PROJECTS ─── */
    #projects { background: linear-gradient(to bottom, transparent, rgba(0,20,40,.4), transparent); }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.8rem;
    }
    .project-card {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 2.2rem;
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
      transition: all .4s;
      clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));
    }
    .project-card::after {
      content:'';
      position: absolute;
      inset: -1px;
      background: linear-gradient(135deg, var(--cyan), transparent, var(--purple));
      opacity: 0;
      transition: opacity .4s;
      z-index: -1;
      clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 30px 100%, 0 calc(100% - 30px));
    }
    .project-card:hover { transform: translateY(-6px); }
    .project-card:hover::after { opacity: 1; }

    .project-num {
      font-family: 'Orbitron', sans-serif;
      font-size: .65rem;
      color: var(--muted);
      letter-spacing: 4px;
      margin-bottom: 1rem;
    }
    .project-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 1rem;
      line-height: 1.4;
    }
    .project-desc {
      font-size: .95rem;
      color: rgba(232,244,255,.55);
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }
    .project-tags { display: flex; flex-wrap: wrap; gap: .5rem; }
    .p-tag {
      padding: .2rem .7rem;
      border: 1px solid rgba(123,47,255,.4);
      font-size: .7rem;
      font-family: 'Space Mono', monospace;
      color: var(--purple);
      background: rgba(123,47,255,.08);
    }
    .project-glow {
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(circle at center, rgba(0,245,255,.04), transparent 60%);
      opacity: 0;
      transition: opacity .4s;
      pointer-events: none;
    }
    .project-card:hover .project-glow { opacity: 1; }

    /* ─── EXPERIENCE ─── */
    #experience { }

    .exp-card {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 3rem;
      backdrop-filter: blur(10px);
      max-width: 800px;
      position: relative;
      overflow: hidden;
    }
    .exp-card::before {
      content:'';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: linear-gradient(to bottom, var(--cyan), var(--purple));
    }
    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
    }
    .exp-role {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: .4rem;
    }
    .exp-company {
      font-size: 1rem;
      color: var(--cyan);
      font-weight: 600;
    }
    .exp-badge {
      padding: .4rem 1rem;
      border: 1px solid var(--neon);
      color: var(--neon);
      font-size: .7rem;
      font-family: 'Space Mono', monospace;
      letter-spacing: 2px;
      white-space: nowrap;
    }
    .exp-list { list-style: none; }
    .exp-list li {
      padding: .5rem 0;
      padding-left: 1.5rem;
      position: relative;
      color: rgba(232,244,255,.7);
      font-size: 1rem;
      line-height: 1.7;
    }
    .exp-list li::before {
      content: '▹';
      position: absolute;
      left: 0;
      color: var(--cyan);
    }

    /* ─── CERTIFICATIONS ─── */
    #certifications { background: linear-gradient(to bottom, transparent, rgba(0,20,40,.4), transparent); }

    .certs-grid {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .cert-card {
      flex: 1;
      min-width: 220px;
      padding: 2rem;
      background: var(--card);
      border: 1px solid var(--border);
      backdrop-filter: blur(10px);
      transition: all .3s;
      position: relative;
    }
    .cert-card::before {
      content:'';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
      transform: scaleX(0);
      transition: transform .3s;
    }
    .cert-card:hover { border-color: var(--cyan); transform: translateY(-4px); }
    .cert-card:hover::before { transform: scaleX(1); }
    .cert-icon { font-size: 2rem; margin-bottom: 1rem; }
    .cert-name {
      font-family: 'Orbitron', sans-serif;
      font-size: .8rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: .4rem;
      line-height: 1.4;
    }
    .cert-issuer { font-size: .8rem; color: var(--muted); letter-spacing: 2px; }

    /* ─── CONTACT ─── */
    #contact { text-align: center; }
    .contact-email {
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(1.2rem, 3vw, 2rem);
      color: var(--cyan);
      margin: 2rem 0;
      text-shadow: 0 0 20px var(--cyan);
      word-break: break-all;
    }
    .contact-info {
      font-size: 1.1rem;
      color: var(--muted);
      margin-bottom: .6rem;
    }
    .contact-cta { margin-top: 3rem; }

    /* ─── FOOTER ─── */
    footer {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 2rem;
      border-top: 1px solid var(--border);
      font-size: .8rem;
      color: var(--muted);
      font-family: 'Space Mono', monospace;
    }

    /* ─── SCROLL INDICATOR ─── */
    .scroll-hint {
      position: absolute;
      bottom: 3rem; left: 50%;
      transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center;
      gap: .5rem;
      opacity: 0;
      color: var(--muted);
      font-size: .7rem;
      letter-spacing: 3px;
    }
    .scroll-mouse {
      width: 22px; height: 36px;
      border: 1px solid var(--muted);
      border-radius: 11px;
      display: flex;
      justify-content: center;
      padding-top: 5px;
    }
    .scroll-wheel {
      width: 3px; height: 7px;
      background: var(--cyan);
      border-radius: 2px;
      animation: scrollWheel 1.5s infinite;
    }
    @keyframes scrollWheel {
      0% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(12px); opacity: 0; }
    }

    /* ─── GLITCH TITLE ANIM ─── */
    @keyframes glitch {
      0%,90%,100% { clip-path: inset(0 0 100% 0); transform: none; }
      91% { clip-path: inset(10% 0 80% 0); transform: translate(-2px,1px); }
      93% { clip-path: inset(60% 0 20% 0); transform: translate(2px,-1px); }
      95% { clip-path: inset(40% 0 40% 0); transform: translate(0,2px); }
    }

    /* ─── FLOATING PARTICLES (CSS fallback) ─── */
    .particle {
      position: fixed;
      width: 2px; height: 2px;
      background: var(--cyan);
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      animation: floatUp linear infinite;
      opacity: 0;
    }
    @keyframes floatUp {
      0% { transform: translateY(100vh); opacity: 0; }
      10% { opacity: .6; }
      90% { opacity: .4; }
      100% { transform: translateY(-10vh); opacity: 0; }
    }

    /* ─── REVEAL ANIMATIONS (GSAP sets these) ─── */
    .reveal { opacity: 0; transform: translateY(30px); }

    /* Responsive tweaks */
    @media (max-width: 900px) {
      section { padding: 6rem 2rem 4rem; }
      nav { padding: 1rem 1.5rem; }
      #hero { flex-direction: column; align-items: flex-start; }
      .hero-right { flex: none; width: 100%; display: flex; justify-content: center; }
      .about-grid { grid-template-columns: 1fr; }
      .projects-grid { grid-template-columns: 1fr; }
